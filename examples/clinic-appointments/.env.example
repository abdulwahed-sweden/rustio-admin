# ============================================================
# clinic-appointments — developer contract
# ============================================================
#
# Copy this file to `.env` and fill the blanks. `.env` is
# gitignored; this `.env.example` is the tracked schema every
# developer reads to know what variables are needed.
#
# NEVER commit a real `.env`. NEVER paste production secrets
# into this file.
#
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME="Clinic Appointments"
APP_ENV=development

DATABASE_URL=postgres://localhost/clinic_appointments_demo

# Session signing secret. 32 bytes minimum. Generate with:
#   openssl rand -base64 48
RUSTIO_SECRET_KEY=


# ------------------------------------------------------------
# Email delivery (password recovery)
# ------------------------------------------------------------
#
# Pick ONE of the two configuration styles below.
#
# === Style A: provider preset (recommended) =================
# Set MAIL_PROVIDER and the framework + CLI auto-fill the
# corresponding SMTP host / port / TLS values. You only have to
# supply credentials.
#
# Known presets:
#   gmail     smtp.gmail.com:465        implicit TLS
#   resend    smtp.resend.com:465       implicit TLS  (user "resend")
#   postmark  smtp.postmarkapp.com:587  STARTTLS
#   mailgun   smtp.mailgun.org:587      STARTTLS
#   sendgrid  smtp.sendgrid.net:587     STARTTLS      (user "apikey")
#   ethereal  smtp.ethereal.email:587   STARTTLS      (dev capture)
#
# Gmail setup (one-time):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate App Password:      https://myaccount.google.com/apppasswords
#      Select app: Mail. Select device: Other → "RustIO Admin".
#   3. Strip spaces from the 16-char password. Paste below.
#
# === Style B: explicit SMTP fields ==========================
# Skip MAIL_PROVIDER, set every SMTP_* field directly. Explicit
# values always override the preset.
#
# === Validation ============================================
# Before booting the app, validate the SMTP config:
#
#   rustio doctor email                       # handshake only
#   rustio doctor email --to you@gmail.com    # full end-to-end send
#   rustio doctor email --html-preview        # open the rendered
#                                             # email in your browser
#                                             # (no SMTP traffic)
#
# Production setups should use Resend / Postmark / AWS SES
# rather than personal Gmail (see README).
# ------------------------------------------------------------

MAIL_PROVIDER=gmail
MAIL_FROM="Clinic Appointments <your-email@gmail.com>"

SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=

# Optional — override the preset's defaults. Leave commented to
# let MAIL_PROVIDER drive them.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_TLS=


# ------------------------------------------------------------
# Recovery emails — operator-facing contact surfaced in the
# email footer as "Need help? Contact <SUPPORT_EMAIL>".
# ------------------------------------------------------------

SUPPORT_EMAIL=support@example.com


# ------------------------------------------------------------
# Runtime environment label — drives the footer chip.
# `development` lights amber, `production` lights green,
# everything else (e.g. "staging", "sandbox") stays neutral.
# ------------------------------------------------------------

RUSTIO_ENV=Development
