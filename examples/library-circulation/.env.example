# Postgres connection. Override per local install.
DATABASE_URL=postgres://localhost/library_circulation_demo

# Session signing secret (32+ bytes). Generate via:
#   openssl rand -base64 48
RUSTIO_SECRET_KEY=<replace-me>


# ----------------------------------------------------------------
# Email transport (the password-recovery flow needs this)
# ----------------------------------------------------------------
#
# If SMTP_HOST is unset, the example falls back to the framework's
# LogMailer — recovery emails print to stdout instead of being
# delivered. Useful for `cargo test` / CI. Set the block below
# when you want a real reset email to land in your inbox.
#
# --- Option A: Gmail SMTP (lowest friction, recommended for
#     local development against your own Gmail) ---
#
# 1. Sign in to https://myaccount.google.com.
# 2. Make sure 2-Step Verification is on
#    (Security → "How you sign in" → 2-Step Verification).
# 3. Open https://myaccount.google.com/apppasswords.
# 4. Generate a 16-character App Password.
#    Name it e.g. "rustio-admin local".
# 5. Copy the 16-char value (Google shows it spaced as
#    "abcd efgh ijkl mnop" — paste WITHOUT the spaces).
#
# MAIL_FROM     = "RustIO Admin <your.address@gmail.com>"
# SMTP_HOST     = smtp.gmail.com
# SMTP_PORT     = 465
# SMTP_USER     = your.address@gmail.com
# SMTP_PASSWORD = abcdEfghIjklMnop          # 16 chars, no spaces
# SMTP_TLS      = implicit
#
# --- Option B: Resend (production-style alternative) ---
#
# 1. Sign up at https://resend.com (free tier, no card).
# 2. Add and verify a sending domain (or use the
#    onboarding@resend.dev sandbox sender).
# 3. Settings → API Keys → create an API key.
#
# MAIL_FROM     = "RustIO Admin <noreply@yourdomain.com>"
# SMTP_HOST     = smtp.resend.com
# SMTP_PORT     = 465
# SMTP_USER     = resend                    # literal, not your email
# SMTP_PASSWORD = re_xxxxxxxxxxxxxxxxxxxx   # the API key
# SMTP_TLS      = implicit
#
# Uncomment + fill in the option you're using:

# MAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=implicit
