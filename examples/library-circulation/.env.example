# ============================================================
# library-circulation — developer contract
# ============================================================
#
# Copy this file to `.env` and fill the blanks. `.env` is
# gitignored; this `.env.example` is the tracked schema every
# developer reads to know what variables are needed.
#
# NEVER commit a real `.env`. NEVER paste production secrets
# into this file.
#
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME="Library Circulation"
APP_ENV=development

DATABASE_URL=postgres://localhost/library_circulation_demo

# Session signing secret. 32 bytes minimum. Generate with:
#   openssl rand -base64 48
RUSTIO_SECRET_KEY=


# ------------------------------------------------------------
# Email delivery (password recovery)
# ------------------------------------------------------------
#
# Gmail SMTP setup (recommended for local development against
# your own Gmail inbox):
#
#   1. Enable Google 2-Step Verification:
#      https://myaccount.google.com/security
#
#   2. Generate a Gmail App Password:
#      https://myaccount.google.com/apppasswords
#
#      Select app:    Mail
#      Select device: Other → "RustIO Admin"
#
#      Google shows a 16-character password formatted as
#      "abcd efgh ijkl mnop". Strip the spaces.
#
#   3. Paste the 16-char value into SMTP_PASSWORD below.
#
# The framework boots with a SMTP smoke test — if your password
# is wrong or 2FA is off, the example refuses to start and
# prints exactly what went wrong. No silent fallback.
#
# To validate the configuration before booting the full app:
#
#   rustio doctor email
#
# That command runs a TLS handshake + authentication round-trip
# and (optionally) sends a one-off test message.
#
# Production setups should use Resend / Postmark / AWS SES
# instead of personal Gmail (see README).
# ------------------------------------------------------------

MAIL_FROM="Library Circulation <your-email@gmail.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
SMTP_TLS=implicit


# ------------------------------------------------------------
# Recovery emails — operator-facing contact surfaced in the
# email footer as "Need help? Contact <SUPPORT_EMAIL>".
# ------------------------------------------------------------

SUPPORT_EMAIL=support@example.com


# ------------------------------------------------------------
# Runtime environment label — drives the footer chip.
# `development` lights amber, `production` lights green,
# everything else (e.g. "staging", "sandbox") stays neutral.
# ------------------------------------------------------------

RUSTIO_ENV=Development
