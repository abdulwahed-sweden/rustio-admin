# Copy this file to `.env` and edit the values. `.env` is for local
# development only — production uses real environment variables.

# Required: the Postgres database the admin connects to.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_admin_dev

# Required in production: signing key for sessions/CSRF. Generate one
# with `openssl rand -hex 32`. A dev default is fine locally.
RUSTIO_SECRET_KEY=dev-only-change-me

# The design layer is owned by rustio-design: `rustio.design.toml` compiles to
# generated/ via `rustio-design build`. Enable both to serve the Tier-1 design
# (grouped sidebar + emerald palette + status colour-coding):
RUSTIO_TEMPLATE_DIR=templates                 # loads generated templates/admin/_sidebar.html
RUSTIO_TOKENS_CSS=generated/tokens.css        # emerald/slate palette + Tier-1 custom_css
