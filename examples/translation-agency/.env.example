# translation-agency — environment template
# Copy to .env and adjust only what you need. Defaults are SAFE FOR LOCAL DEV.

# env_logger filter. "rustio_admin=debug" for framework internals.
RUST_LOG=info

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres            # IMPORTANT: change in production
DB_NAME=translation_agency_dev

# rustio-admin reads this directly; the components above are substituted
# at .env load time.
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Security ──────────────────────────────────────────────────
# CSRF, session cookies, and password hashing are managed by the framework.
# RUSTIO_SECRET_KEY is only required if you enable MFA. Generate with:
#   openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
RUSTIO_SECRET_KEY=

# ── Initial admin account ─────────────────────────────────────
# Created via the CLI, not env vars:
#   rustio-admin-cli user create --email coordinator@agency.local --role administrator
